# Copy to .env.local and fill in values there. Never commit .env.local.
# See the README "Environment variables" table for details.

# Required: your own X developer app (OAuth 2.0, confidential client)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:3001/api/auth/x/callback

# Optional: enables Grok features
XAI_API_KEY=

# Optional, non-secret
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
# STIMGRAPH_BACKGROUND_POLL=false
# STIMGRAPH_AGENT_API=on
# STIMGRAPH_AGENT_LOGINS=

# Always-on mode only: set by scripts/install-tailnet-service.mjs, not here.
# STIMGRAPH_TAILNET=true
# STIMGRAPH_TAILNET_LOGIN=you@example.com
# STIMGRAPH_PUBLIC_ORIGIN=https://<host>.<tailnet>.ts.net
# STIMGRAPH_DATABASE=/absolute/path/stimgraph.sqlite
# STIMGRAPH_CREDENTIAL_SOURCE=keychain
