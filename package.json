{
  "name": "stimgraph",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "build:local": "next build --webpack",
    "start:local": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint . --ignore-pattern dist --ignore-pattern .next && node --experimental-strip-types --test lib/*.test.ts",
    "jev:label": "node scripts/jev-label.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "4.20260702.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1",
    "drizzle-kit": "0.31.11"
  },
  "type": "module",
  "packageManager": "pnpm@10.17.1"
}
